# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional server session signing secret (auto-generated in data/ if omitted)
SESSION_SECRET=""

# Optional Web Push VAPID keys for persistent iOS/Browser push notifications
# (auto-generated in data/vapid.json if omitted)
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:haus@hausofhunz.app"
