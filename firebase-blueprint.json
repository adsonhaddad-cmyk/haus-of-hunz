  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserPublic" },
      "description": "Non-PII user link to household and resident profile."
    },
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/UserPrivateProfile" },
      "description": "Owner-only PII storage (email)."
    },
    "/invites/{inviteCode}": {
      "schema": { "$ref": "#/entities/HouseholdInvite" },
      "description": "Invite code mapping to householdId for partner onboarding."
    },
    "/households/{householdId}": {
      "schema": { "$ref": "#/entities/Household" },
      "description": "Household document containing settings, timezone, and penalty rules."
    },
    "/households/{householdId}/members/{memberUid}": {
      "schema": { "$ref": "#/entities/HouseholdMember" },
      "description": "Membership gate verifying Firebase Auth UID belongs to the household."
    },
    "/households/{householdId}/residents/{residentId}": {
      "schema": { "$ref": "#/entities/ResidentProfile" },
      "description": "Partner profiles, avatars, points, streaks, and shade settings."
    },
    "/households/{householdId}/tasks/{taskId}": {
      "schema": { "$ref": "#/entities/HouseholdTask" },
      "description": "Household chores, deadlines, and rotation state."
    },
    "/households/{householdId}/shoppingItems/{itemId}": {
      "schema": { "$ref": "#/entities/ShoppingItem" },
      "description": "Shared shopping list items."
    },
    "/households/{householdId}/pinNotes/{noteId}": {
      "schema": { "$ref": "#/entities/PinNote" },
      "description": "House Pinboard notes."
    },
    "/households/{householdId}/pointLedger/{txId}": {
