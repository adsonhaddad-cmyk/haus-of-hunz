    "HouseholdTask": {
      "title": "HouseholdTask",
      "description": "Shared household chore with rotation pool, authoritative dueAt timestamp, and bounded history.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "maxLength": 280
        },
        "category": {
          "type": "string",
          "enum": ["Limpeza", "Cozinha", "Organização", "Manutenção", "Geral"]
        },
        "points": {
          "type": "number"
        },
        "priority": {
          "type": "string",
          "enum": ["alta", "media", "normal"]
        },
        "frequency": {
          "type": "string",
          "enum": ["once", "daily", "weekly", "biweekly", "monthly", "custom"]
        },
        "customIntervalDays": {
          "type": "number"
        },
        "assignedToId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "participantIds": {
          "type": "array"
        },
        "dueDate": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "dueTime": {
          "type": "string",
          "minLength": 5,
          "maxLength": 5,
          "pattern": "^[0-9]{2}:[0-9]{2}$"
        },
        "dueAt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "occurrenceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "occurrenceSeq": {
          "type": "number"
        },
        "status": {
          "type": "string",
          "enum": ["pending", "completed", "paused"]
        },
        "pausedUntil": {
          "type": "string",
          "maxLength": 40
        },
        "pausedReason": {
          "type": "string",
          "maxLength": 120
        },
        "reassignedAt": {
          "type": "string",
          "maxLength": 40
        },
        "reassignedBeforeDeadline": {
          "type": "boolean"
        },
        "lastCompletedOccurrenceKey": {
          "type": "string",
          "maxLength": 160
        },
        "history": {
          "type": "array"
        },
        "createdByUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "memberUids": {
          "type": "array"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "title",
        "category",
        "points",
        "priority",
        "frequency",
        "assignedToId",
        "participantIds",
        "dueDate",
        "dueTime",
        "dueAt",
        "occurrenceId",
        "occurrenceSeq",
        "status",
        "history",
        "createdByUid",
        "memberUids",
        "createdAt",
        "updatedAt"
      ]
    },
